{
  "name": "verdant-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Seasonal animation and procedural growth for EZ Tree and Three.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && npm run build:lib && npm run build:demo",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ez-tree:update": "node scripts/ez-tree-update.mjs",
    "ez-tree:apply": "node scripts/ez-tree-update.mjs --apply",
    "ez-tree:discard": "node scripts/ez-tree-update.mjs --discard"
  },
  "dependencies": {
    "@verdant-motion/ez-tree-generator": "file:packages/ez-tree",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.169.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/lib/verdant-motion.js"
    }
  }
}
