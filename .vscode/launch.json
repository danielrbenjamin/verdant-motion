{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo Verdant Motion",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--host", "127.0.0.1", "--port", "5174"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:.*(http://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
